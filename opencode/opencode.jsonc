{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": {
      "/home/mydum/Desktop/projects/mydum/**": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "trafilatura": {
      "type": "local",
      "enabled": false,
      "command": [
        "uv",
        "run",
        "--with",
        "fastmcp",
        "--with",
        "trafilatura",
        "/home/mydum/searcharvester/trafilatura-mcp.py"
      ]
    },
    "searcharvester": {
      "type": "local",
      "enabled": false,
      "command": [
        "uv",
        "run",
        "--with",
        "fastmcp",
        "--with",
        "httpx",
        "/home/mydum/searcharvester/mcp-server.py"
      ]
    },
    "youtube-transcript": {
      "type": "local",
      "enabled": false,
      "command": [
        "uv",
        "run",
        "--with",
        "fastmcp",
        "--with",
        "youtube-transcript-api",
        "/home/mydum/searcharvester/youtube-transcript-mcp.py"
      ]
    }
  },
  "enabled_providers": [
    "opencode-go",
    "openai"
  ],
  "model": "opencode-go/deepseek-v4.1-flash",
  "providers": {
    "opencode-go": {
      "models": {
        "beam-free": {
          "disabled": true
        },
        "claude-haiku-5-5": {
          "disabled": true
        },
        "gemini-4-argon": {
          "disabled": true
        },
        "glm-5.2": {
          "disabled": true
        },
        "glm-5.3": {
          "disabled": true
        },
        "glm-5.3-flash": {
          "disabled": true
        },
        "gpt-5.6-luna": {
          "disabled": true
        },
        "gpt-6-luna": {
          "disabled": true
        },
        "grok-4.7": {
          "disabled": true
        },
        "hy3": {
          "disabled": true
        },
        "hy4": {
          "disabled": true
        },
        "hy4-preview": {
          "disabled": true
        },
        "iceman-contributor-free": {
          "disabled": true
        },
        "kimi-k2.7-code": {
          "disabled": true
        },
        "kimi-k3": {
          "disabled": true
        },
        "kimi-k3.1-pro": {
          "disabled": true
        },
        "longcat-2.0": {
          "disabled": true
        },
        "longcat-2.5-free": {
          "disabled": true
        },
        "mimo-v2.5": {
          "disabled": true
        },
        "mimo-v2.5-pro": {
          "disabled": true
        },
        "mimo-v2.6-flash": {
          "disabled": true
        },
        "mimo-v2.6-pro": {
          "disabled": true
        },
        "minimax-m3": {
          "disabled": true
        },
        "minimax-m3.1-flash": {
          "disabled": true
        },
        "muse-spark-1.2-contributor": {
          "disabled": true
        },
        "muse-spark-1.3-contributor": {
          "disabled": true
        },
        "qwen3.7-plus": {
          "disabled": true
        },
        "qwen3.8-flash": {
